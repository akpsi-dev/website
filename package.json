{
  "name": "website",
  "version": "0.9.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@vercel/analytics": "^1.5.0",
    "axios": "^1.7.7",
    "framer-motion": "^11.3.30",
    "lenis": "^1.3.23",
    "lucide-react": "^0.439.0",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.26.1",
    "react-scripts": "^5.0.1",
    "recharts": "^2.12.7",
    "split-type": "^0.3.4",
    "swr": "^2.4.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env CI=false react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "size": "size-limit",
    "optimize-images": "node scripts/optimize-images.mjs"
  },
  "size-limit": [
    {
      "name": "initial JS (main bundle, gzip)",
      "path": "build/static/js/main.*.js",
      "limit": "250 KB"
    }
  ],
  "jest": {
    "moduleNameMapper": {
      "^@vercel/analytics/react$": "<rootDir>/node_modules/@vercel/analytics/dist/react/index.js",
      "^swr$": "<rootDir>/node_modules/swr/dist/index/index.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(lenis|ogl)/)",
      "^.+\\.module\\.(css|sass|scss)$"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource/spline-sans-mono": "^5.2.8",
    "@size-limit/file": "^12.1.0",
    "cross-env": "^10.0.0",
    "dotenv": "^16.4.5",
    "prettier": "3.3.3",
    "sharp": "^0.35.0",
    "size-limit": "^12.1.0"
  }
}
